---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stjakinn from '../components/Stjakinn.astro';

const recipients = await getCollection('styrkthegar');
const latestYear = Math.max(...recipients.map((r) => r.data.year));
const latest = recipients.filter((r) => r.data.year === latestYear);
const ceremonies = (await getCollection('styrkveitingar')).sort((a, b) => b.data.year - a.data.year);
const latestCeremony = ceremonies[0];
---
<Base>
  <section class="hero">
    <div class="prose">
      <h1>Minningarsjóður frú Stefaníu Guðmundsdóttur</h1>
      <p>
        Sjóðurinn var stofnaður árið 1938 af hjónunum Önnu Borg og Poul Reumert til að efla íslenska leiklist
        og heiðra minningu Stefaníu Guðmundsdóttur (1876–1926), eins merkasta brautryðjanda leiklistar á Íslandi.
        Frá árinu 1970 hafa {recipients.length} leikarar og leiklistarfólk hlotið styrk úr sjóðnum.
      </p>
      <p><a href="/um-sjodinn">Meira um sjóðinn →</a></p>
    </div>
    <Stjakinn />
  </section>

  <section>
    <h2 class="year-heading">Nýjustu styrkþegar · {latestCeremony?.data.season ?? latestYear}</h2>
    <div class="grid">
      {latest.map((p) => (
        <a class="card" href={`/styrkthegar/${p.id}`}>
          {p.data.photo ? <img src={p.data.photo} alt={p.data.name} /> : <div class="no-photo">Mynd vantar</div>}
          <h3>{p.data.name}</h3>
        </a>
      ))}
    </div>
    <p><a href="/styrkthegar">Allir styrkþegar →</a></p>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 2rem; align-items: center; margin-bottom: 3rem; }
  @media (min-width: 56rem) { .hero { grid-template-columns: 1.4fr 1fr; } }
</style>
