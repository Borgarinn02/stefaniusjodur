---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import { getNews } from '../lib/news';

const recipients = await getCollection('styrkthegar');
// The three most recent recipients (newest year first; alphabetical within a year)
const latest = [...recipients]
  .sort((a, b) => b.data.year - a.data.year || a.data.name.localeCompare(b.data.name, 'is'))
  .slice(0, 3);

const news = await getNews();
const featured = news.find((n) => n.data.featured);
const otherNews = news.filter((n) => n !== featured).slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="prose">
      <h1>Minningarsjóður frú Stefaníu Guðmundsdóttur</h1>
      <p>
        Sjóðurinn á rætur að rekja til ársins 1938, þegar hjónin Anna Borg og Poul Reumert lögðu tekjur
        af gestaleik sínum í Reykjavík til hliðar í minningu Stefaníu Guðmundsdóttur (1876–1926), eins
        merkasta brautryðjanda leiklistar á Íslandi. Sjóðurinn var formlega stofnaður árið 1965 og frá
        árinu 1970 hafa yfir 50 leikarar og leiklistarfólk hlotið styrk úr honum.
      </p>
      <p><a href={u('/um-sjodinn')}>Meira um sjóðinn →</a></p>
    </div>
    <figure class="hero-photo">
      <a href={u('/stefania')}>
        <img class="mounted" src={u('/images/stefania-magda.jpg')} alt="Stefanía Guðmundsdóttir í hlutverki Mögdu í Heimilinu (Heimat), um 1901–1902" />
      </a>
      <figcaption>Frú Stefanía Guðmundsdóttir (1876–1926) í hlutverki Mögdu í <em>Heimilinu</em>, um 1901–1902</figcaption>
    </figure>
  </section>

  {featured && (
    <section class="featured" aria-label="Í brennidepli">
      <h2 class="year-heading">Í brennidepli</h2>
      <NewsCard item={featured} large />
    </section>
  )}

  <section>
    <h2 class="year-heading">Nýjustu styrkþegar</h2>
    <div class="grid">
      {latest.map((p) => (
        <a class="card" href={u(`/styrkthegar/${p.id}`)}>
          {p.data.photo ? <img src={u(p.data.photo)} alt={p.data.name} /> : <div class="no-photo">Mynd vantar</div>}
          <h3>{p.data.name}</h3>
          <p class="card-year">{p.data.year}</p>
        </a>
      ))}
    </div>
    <p><a href={u('/styrkthegar')}>Allir styrkþegar →</a></p>
  </section>

  <section>
    <h2 class="year-heading">Fréttir og viðburðir</h2>
    {otherNews.length > 0 && <div class="news-list">{otherNews.map((item) => <NewsCard item={item} />)}</div>}
    <p class="follow">
      <a href={u('/i-brennidepli')}>Allar fréttir og viðburðir →</a>
      <span aria-hidden="true">·</span>
      <a href="https://www.facebook.com/stefaniusjodur" rel="noopener">Fylgstu með sjóðnum á Facebook</a>
    </p>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 2rem; align-items: center; margin-bottom: 2rem; }
  @media (min-width: 56rem) { .hero { grid-template-columns: 1.4fr 1fr; } }
  .card-year { margin: 0; font: italic .95rem var(--serif); color: var(--ink-soft); }
  .hero-photo { margin: 0; display: grid; justify-items: center; gap: .6rem; }
  .hero-photo img { max-height: 30rem; width: auto; filter: sepia(.1); transform: rotate(1.2deg); transition: transform .3s ease; }
  .hero-photo a:hover img { transform: rotate(0deg); }
  .hero-photo figcaption { font-style: italic; font-size: .95rem; color: var(--ink-soft); text-align: center; max-width: 22rem; }
  @media (prefers-reduced-motion: reduce) { .hero-photo img { transition: none; } }
  .featured { margin-bottom: 1rem; }
  .news-list { display: grid; gap: 2rem; max-width: 48rem; }
  .follow { display: flex; flex-wrap: wrap; gap: .25rem .75rem; }
</style>
