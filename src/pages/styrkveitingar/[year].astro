---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('styrkveitingar');
  return all.map((c) => ({ params: { year: c.id }, props: { c } }));
}
const { c } = Astro.props;
const { Content } = await render(c);
---
<Base title={c.data.title}>
  <p><a href="/styrkveitingar">← Allar styrkveitingar</a></p>
  <article class="prose">
    <p class="muted">Styrkveiting {c.data.season}</p>
    <h1>{c.data.title}</h1>
    <Content />
  </article>
</Base>
