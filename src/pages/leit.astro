---
import Base from '../layouts/Base.astro';
// The search index is generated by Pagefind after `astro build` (see the build script),
// so search only works on the built site (`npm run build && npm run preview`), not in `npm run dev`.
const bundle = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/`;
---
<Base title="Leit">
  <div data-pagefind-ignore="all">
    <h1>Leit</h1>
    <p class="prose muted">Leitaðu að styrkþegum, leikritum, árum eða öðru efni á vefnum.</p>
    <div id="search" data-bundle={bundle}></div>
    <noscript><p>Leitin krefst JavaScript.</p></noscript>
  </div>
</Base>

<link rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
<script is:inline define:vars={{ bundle }}>
  const s = document.createElement('script');
  s.src = bundle + 'pagefind-ui.js';
  s.onload = () => {
    // eslint-disable-next-line no-undef
    new PagefindUI({
      element: '#search',
      bundlePath: bundle,
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      translations: {
        placeholder: 'Leita á vefnum…',
        clear_search: 'Hreinsa',
        load_more: 'Sýna fleiri niðurstöður',
        search_label: 'Leita á vefnum',
        zero_results: 'Engar niðurstöður fyrir [SEARCH_TERM]',
        many_results: '[COUNT] niðurstöður fyrir [SEARCH_TERM]',
        one_result: '[COUNT] niðurstaða fyrir [SEARCH_TERM]',
        searching: 'Leita að [SEARCH_TERM]…',
      },
    });
    const q = new URLSearchParams(location.search).get('q');
    const input = document.querySelector('#search input');
    if (q && input) { input.value = q; input.dispatchEvent(new Event('input')); }
    input?.focus();
  };
  s.onerror = () => {
    document.getElementById('search').innerHTML = '<p class="muted">Leitin er aðeins virk á útgefnum vef (eftir <code>npm run build</code>).</p>';
  };
  document.head.appendChild(s);
</script>

<style is:global>
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--coffee-800);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper-light);
    --pagefind-ui-border: var(--paper-edge);
    --pagefind-ui-tag: var(--paper);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--serif);
    max-width: 48rem;
    margin-top: 2rem;
  }
  #search .pagefind-ui__result-link { color: var(--link); font-family: var(--display); font-size: 1.25rem; }
  #search .pagefind-ui__result-excerpt mark { background: rgba(201, 164, 106, .45); color: inherit; }
  #search .pagefind-ui__search-input { font-family: var(--serif); }
  #search .pagefind-ui__search-clear { font: italic 1rem var(--serif); color: var(--ink-soft); background: transparent; }
  #search .pagefind-ui__button { font-family: var(--display); color: var(--cream); background: var(--coffee-800); border-color: var(--coffee-800); }
</style>
