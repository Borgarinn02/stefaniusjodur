---
import { u } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('styrkthegar');
  return all.map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const { Content } = await render(r);
const hasBio = Boolean(r.body?.trim());
---
<Base title={r.data.name}>
  <p><a href={u('/styrkthegar')}>← Allir styrkþegar</a></p>
  <article class="profile">
    {r.data.photo && (
      <figure>
        <img class="mounted" src={u(r.data.photo)} alt={r.data.name} />
        {r.data.photoCredit && <figcaption class="muted">Ljósmynd: {r.data.photoCredit}</figcaption>}
      </figure>
    )}
    <div class="prose">
      <p class="muted">Styrkþegi {r.data.year}</p>
      <h1>{r.data.name}</h1>
      {hasBio ? <Content /> : <p class="muted">Umfjöllun væntanleg.</p>}
    </div>
  </article>
</Base>

<style>
  .profile { display: grid; gap: 2rem; }
  @media (min-width: 48rem) { .profile { grid-template-columns: 16rem 1fr; align-items: start; } }
  figure { margin: 0; }
  figcaption { font: .8rem var(--serif); margin-top: .5rem; }
</style>
